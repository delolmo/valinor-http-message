{
    "name": "delolmo/valinor-http-message",
    "description": "Map PSR-7 server requests (query params, parsed body and attributes) to typed PHP objects with cuyz/valinor.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "valinor",
        "psr-7",
        "http-message",
        "request",
        "mapper",
        "object-mapper",
        "hydration",
        "dto",
        "source"
    ],
    "authors": [
        {
            "name": "Antonio del Olmo",
            "email": "antonio@delolmo.pro"
        }
    ],
    "homepage": "https://github.com/delolmo/valinor-http-message",
    "support": {
        "issues": "https://github.com/delolmo/valinor-http-message/issues"
    },
    "require": {
        "php": "~8.4.27 || ^8.5.12",
        "cuyz/valinor": "^2.6",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "captainhook/captainhook-phar": "^5.29",
        "captainhook/plugin-composer": "^5.3",
        "doctrine/coding-standard": "^14.0",
        "ergebnis/composer-normalize": "^2.54",
        "infection/infection": "^0.35",
        "laminas/laminas-diactoros": "^3.6",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.4",
        "psalm/plugin-phpunit": "^0.19",
        "ramsey/conventional-commits": "^1.7",
        "rector/rector": "^2.8",
        "roave/security-advisories": "dev-latest",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "vimeo/psalm": "^6.20"
    },
    "autoload": {
        "psr-4": {
            "DelOlmo\\Valinor\\Mapper\\Source\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DelOlmo\\Valinor\\Mapper\\Source\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "captainhook/captainhook-phar": true,
            "captainhook/plugin-composer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true
        },
        "platform": {
            "php": "8.4.27"
        },
        "sort-packages": true
    },
    "scripts": {
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "php -d memory_limit=2G vendor/bin/phpunit --configuration phpunit.xml.dist --coverage-html var/coverage"
        ],
        "deps": [
            "@putenv XDEBUG_MODE=off",
            "composer-dependency-analyser"
        ],
        "fix": [
            "@putenv XDEBUG_MODE=off",
            "rector process",
            "@phpcbf"
        ],
        "infection": [
            "@putenv XDEBUG_MODE=coverage",
            "php -d memory_limit=2G -d opcache.enable_cli=1 vendor/bin/infection --threads=max --show-mutations=0 --no-progress"
        ],
        "infection-diff": [
            "@putenv XDEBUG_MODE=coverage",
            "git add --intent-to-add --all -- src",
            "php -d memory_limit=2G -d opcache.enable_cli=1 vendor/bin/infection --threads=max --show-mutations=0 --no-progress --git-diff-filter=AM --git-diff-base=origin/main --ignore-msi-with-no-mutations"
        ],
        "lint": [
            "@putenv XDEBUG_MODE=off",
            "parallel-lint ./src ./tests"
        ],
        "phpcbf": [
            "@putenv XDEBUG_MODE=off",
            "phpcbf"
        ],
        "phpcs": [
            "@putenv XDEBUG_MODE=off",
            "phpcs -s --colors --cache"
        ],
        "phpstan": [
            "@putenv XDEBUG_MODE=off",
            "phpstan analyse --memory-limit 2G"
        ],
        "phpunit": [
            "@putenv XDEBUG_MODE=off",
            "phpunit --configuration phpunit.xml.dist --no-coverage"
        ],
        "psalm": [
            "@putenv XDEBUG_MODE=off",
            "psalm --config psalm.xml"
        ],
        "rector": [
            "@putenv XDEBUG_MODE=off",
            "rector process --dry-run"
        ]
    }
}
